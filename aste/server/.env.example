# Copia in .env e compila. In produzione usa il gestore di segreti dell'hosting, non un file.
NODE_ENV=development
PORT=3000
# Web app (link nelle email) e server API (immagini in sviluppo)
PUBLIC_URL=http://localhost:8081
API_URL=http://localhost:3000
# Origini web ammesse (CORS), separate da virgola. Le app mobili non usano CORS.
CORS_ORIGINS=http://localhost:8081

DATABASE_URL=postgres://postgres@127.0.0.1:5432/aste
REDIS_URL=redis://127.0.0.1:6379

# Commissioni della piattaforma, in punti base (100 = 1%)
SELLER_FEE_BPS=1000
BUYER_FEE_BPS=500

# Stripe Connect (chiavi di test: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Archiviazione immagini S3-compatibile (in sviluppo, senza S3_BUCKET, si usa il disco locale)
S3_BUCKET=
S3_REGION=eu-south-1
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# Notifiche push Expo (token di accesso consigliato in produzione: Expo > Account > Access tokens)
EXPO_ACCESS_TOKEN=

# Email (in sviluppo, senza SMTP_URL, le email vengono scritte nel log)
SMTP_URL=
MAIL_FROM="Aste <no-reply@example.com>"
