# Configurazione del server. Copia in .env (mai nel repository) e compila.

# Dominio con record DNS A verso questo server, es. aste.tuodominio.it
DOMAIN=
# Password lunga e casuale: openssl rand -base64 32
POSTGRES_PASSWORD=

# Stripe (modalità test per la prova: sk_test_..., pk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email transazionali (es. Brevo, Postmark, Amazon SES): smtps://utente:password@host:465
SMTP_URL=
MAIL_FROM="Aste <no-reply@tuodominio.it>"

# Immagini: su un server unico basta il disco (volume "uploads", incluso nei backup).
# Per crescere: S3 compatibile (Hetzner, Scaleway, AWS) con S3_BUCKET, S3_ENDPOINT, S3_PUBLIC_BASE_URL.
ALLOW_LOCAL_STORAGE=1

# Collegamento app ↔ dominio (link nelle email che aprono l'app)
APP_BUNDLE_ID=it.asteonline.app
# Apple Developer → Membership → Team ID
APPLE_TEAM_ID=
# Impronta SHA-256 del certificato Android: npx eas-cli credentials -p android
ANDROID_CERT_SHA256=

# Notifiche push: Expo → Account settings → Access tokens
EXPO_ACCESS_TOKEN=

# Commissioni in punti base (100 = 1%)
SELLER_FEE_BPS=1000
BUYER_FEE_BPS=500
